ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://psx:psx@localhost:55432/psx_fertilizer

# Non-negotiable compliance gate — do not set these true without the documented
# review described in docs/rights_matrix.template.md and docs/research_disclaimer.md
PUBLIC_LAUNCH_ENABLED=false
PUBLIC_SIGNALS_ENABLED=false
COMMERCIAL_DATA_ENABLED=false

# Free account + generated key from https://easydata.sbp.org.pk (My Data Basket > My Account)
SBP_EASYDATA_API_KEY=

# Gemini API key for the PSX Senior Analyst Agent's LLM synthesis step.
# Get one at https://aistudio.google.com/apikey. When unset, synthesis falls back to a
# deterministic rule-based summary instead of an LLM-generated narrative.
GEMINI_API_KEY=
